{
  "name": "riffado-mcp",
  "version": "0.2.0",
  "description": "MCP server for the Riffado voice-recording archive (transcripts, AI summaries, key points, action items) — read-only.",
  "license": "MIT",
  "author": "Nico Struck",
  "type": "module",
  "private": true,
  "keywords": [
    "mcp",
    "model-context-protocol",
    "riffado",
    "plaud",
    "transcription",
    "claude"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/L480/riffado-mcp.git"
  },
  "bugs": {
    "url": "https://github.com/L480/riffado-mcp/issues"
  },
  "homepage": "https://github.com/L480/riffado-mcp#readme",
  "bin": {
    "riffado-mcp": "dist/index.js"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc",
    "clean": "rm -rf dist",
    "lint": "eslint src test",
    "lint:fix": "eslint --fix src test",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.test.json",
    "test": "vitest run --config vitest.config.ts",
    "test:watch": "vitest watch --config vitest.config.ts",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "prepare": "npm run build",
    "start": "node dist/index.js"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "express-rate-limit": "^8.7.0",
    "pg": "^8.23.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.2",
    "@types/pg": "^8.23.1",
    "@vitest/coverage-v8": "^4.1.11",
    "eslint": "^9.39.5",
    "prettier": "^3.9.8",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.70.0",
    "vitest": "^4.1.11"
  }
}
